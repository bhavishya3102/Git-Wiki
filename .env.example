PORT=3000

# Set to 1 for local development against the Inngest Dev Server.
INNGEST_DEV=1

PINECONE_API_KEY=
PINECONE_INDEX=git-wiki

# Only needed once you deploy (INNGEST_DEV unset).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional: raises the GitHub API rate limit (60 requests/hour without it).
GITHUB_TOKEN=

# Neon Postgres connection string — stores users and their shelved repos.
DATABASE_URL=

# GitHub OAuth App (https://github.com/settings/developers).
# Authorization callback URL: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only needed when the callback differs from the dev URL above.
GITHUB_CALLBACK_URL=

# Signs the session cookie. Any long random string: `openssl rand -hex 32`.
JWT_SECRET=

# Needed by POST /ask to generate answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
