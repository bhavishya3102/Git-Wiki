PORT=3000

# Set to 1 for local development against the Inngest Dev Server.
INNGEST_DEV=1

PINECONE_API_KEY=
PINECONE_INDEX=git-wiki

# Only needed once you deploy (INNGEST_DEV unset).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional: raises the GitHub API rate limit and allows private repos.
GITHUB_TOKEN=
